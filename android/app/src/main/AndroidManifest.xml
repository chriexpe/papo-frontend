<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Gravar recado de voz. Pedida na hora em que alguém toca em gravar,
         não na abertura: permissão pedida sem motivo à vista é permissão
         negada. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Câmera da call. Pedida ao ligar a câmera, não antes. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- O aparelho pode não ter câmera e o Papo continua servindo. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- O egui desenha por OpenGL ES 3.0 (o back-end `glow` do eframe). -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Papo">

        <!-- A Activity é uma subclasse mínima do GameActivity: a única
             coisa que ela faz é medir as bordas do sistema. O `lib_name` é o
             nome da biblioteca que ela carrega — o `libpapo.so` que o
             `cargo ndk` deixa em `jniLibs`, sem o `lib` e sem o `.so`. -->
        <activity
            android:name=".PapoActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|density|uiMode|navigation|fontScale"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="android.app.lib_name"
                android:value="papo" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CallService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback|microphone|camera" />
    </application>
</manifest>
