# Maintainer: chriexpe <chrishattge45@gmail.com>
#
# Pacote para Arch e derivados (o autor usa CachyOS). Compila do fonte e
# instala o binário, o .desktop, os ícones e os metadados da loja.
pkgname=papo
pkgver=0.5.1
pkgrel=1
pkgdesc="Cliente nativo do Papo — chat self-hosted"
arch=('x86_64' 'aarch64')
url="https://github.com/chriexpe/papo-frontend"
license=('AGPL-3.0-or-later')
# O GStreamer é ligado dinamicamente: sem os plugins não há mídia nenhuma.
depends=(
    'gstreamer'
    'gst-plugins-base'
    'gst-plugins-good'
    'gst-plugins-bad'
    'gst-libav'
    # O ICE do webrtcbin. Sem ele a call nem começa a negociar.
    'libnice'
    'libxkbcommon'
    'wayland'
    'libx11'
    'fontconfig'
)
# Para o áudio sair e o microfone entrar; um dos dois basta.
optdepends=(
    'pipewire: saída e entrada de áudio'
    'gst-plugin-pipewire: saída e entrada de áudio pelo PipeWire'
    'xdg-desktop-portal: seletor de arquivos do sistema'
    'noto-fonts-emoji: emoji colorido'
)
makedepends=('rust' 'cargo' 'pkgconf' 'git')
# O rsRPC é o fallback do Rich Presence; mesma revisão de
# packaging/rsrpc/REVISION, compilada do fonte como nos outros pacotes.
_rsrpc_commit=572b609d400d44244dc90c05c06410a47d0d039c
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "rsrpc::git+https://github.com/pog5/rsrpc.git#commit=$_rsrpc_commit")
# Preencha com `makepkg -g` depois de publicar a etiqueta: só aí o tarball
# do GitHub existe para ter soma. O git já é conferido pelo commit.
sha256sums=('SKIP'
            'SKIP')

_app_id=io.github.chriexpe.Papo

build() {
    cd "papo-frontend-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --locked --all-features

    cd "$srcdir/rsrpc"
    cargo build --release --locked
}

check() {
    cd "papo-frontend-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --locked
}

package() {
    cd "papo-frontend-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "packaging/$_app_id.desktop" \
        "$pkgdir/usr/share/applications/$_app_id.desktop"
    install -Dm644 "packaging/$_app_id.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/$_app_id.metainfo.xml"

    # Os tamanhos já vêm prontos no repositório; nada de ImageMagick aqui.
    for icon in assets/icons/*.png; do
        size="$(basename "$icon" .png)"
        install -Dm644 "$icon" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$_app_id.png"
    done
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # No Arch os auxiliares ficam em /usr/lib/<pacote>, não em libexec.
    install -Dm755 "$srcdir/rsrpc/target/release/rsrpc" "$pkgdir/usr/lib/$pkgname/rsrpc"
    install -Dm644 packaging/rsrpc/LICENSE "$pkgdir/usr/share/licenses/$pkgname/RSRPC-LICENSE"
    install -Dm644 packaging/rsrpc/NOTICE "$pkgdir/usr/share/licenses/$pkgname/RSRPC-NOTICE"
}
